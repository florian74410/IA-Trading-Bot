{
  "id": "marketdata",
  "label": "Market Data Collector",
  "type": "MODULE",
  "transport": "CP1",
  "endpoint": {
    "host": "127.0.0.1",
    "port": 8013,
    "cpPath": "/cp/v1",
    "healthPath": "/health"
  },
  "table": {
    "commands": [
      {
        "name": "marketdata.health",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "marketdata.candles",
        "arguments": {
          "allowed": [
            "symbol",
            "timeframe",
            "limit",
            "force",
            "exchange",
            "source"
          ],
          "required": [
            "symbol",
            "timeframe"
          ]
        }
      },
      {
        "name": "marketdata.refresh",
        "arguments": {
          "allowed": [
            "symbol",
            "timeframe",
            "limit",
            "exchange",
            "source"
          ],
          "required": [
            "symbol",
            "timeframe"
          ]
        }
      },
      {
        "name": "marketdata.active",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "marketdata.cache.clear",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "marketdata.registry.status",
        "description": "État du Market Registry.",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "marketdata.registry.refresh",
        "description": "Synchronise le Registry via son provider.",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "marketdata.registry.asset",
        "description": "Retourne la fiche d'un actif.",
        "arguments": {
          "allowed": [
            "id",
            "symbol",
            "name",
            "term",
            "detail"
          ]
        }
      },
      {
        "name": "marketdata.registry.search",
        "description": "Recherche un actif.",
        "arguments": {
          "allowed": [
            "term",
            "query",
            "limit"
          ]
        }
      },
      {
        "name": "marketdata.registry.list",
        "description": "Liste paginée du Registry.",
        "arguments": {
          "allowed": [
            "offset",
            "limit",
            "term"
          ]
        }
      },
      {
        "name": "marketdata.registry.query",
        "description": "Contrat commun Registry pour UI, Chat IA et Supervisor.",
        "arguments": {
          "allowed": [
            "action",
            "arguments",
            "args"
          ]
        }
      }
    ],
    "dataTypes": [
      {
        "name": "market.candles",
        "direction": "PRODUCE",
        "schema": "market.candles/1.0"
      },
      {
        "name": "market.ticker",
        "direction": "PRODUCE"
      },
      {
        "name": "market.volume",
        "direction": "PRODUCE"
      },
      {
        "name": "market.consensus",
        "direction": "PRODUCE"
      },
      {
        "name": "market.registry",
        "direction": "PRODUCE",
        "schema": "market.registry/1.0",
        "description": "Catalogue local d'actifs, marchés et métadonnées."
      }
    ],
    "events": []
  }
}
