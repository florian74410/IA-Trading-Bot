  "strategy_logic": {
    "name": "MTF Pullback Recovery + Breakdown Failsafe",
    "primary_side": "LONG",
    "secondary_side": "SHORT_ONLY_AFTER_REGIME_BREAK",
    "no_trade_default": true,
    "long_regime_filter_all": [
      "EMA9_4h > EMA21_4h",
      "close_1h > EMA21_1h",
      "RSI14_4h >= 52 and RSI14_4h <= 75",
      "RSI14_1d < 78",
      "spread_pct <= 0.05"
    ],
    "long_setup_all": [
      "RSI14_15m >= 28 and RSI14_15m <= 48",
      "close_15m >= BollingerLower_15m - 0.15 * ATR14_15m",
      "price is not more than 1.5 * ATR14_15m above EMA9_15m",
      "15m structure has not closed below the current 1h invalidation support"
    ],
    "long_trigger_all": [
      "5m close crosses above EMA9_5m",
      "RSI14_5m crosses upward through 38",
      "5m close > highest high of previous 2 completed 5m candles OR 5m close > local micro swing high",
      "5m volume >= 1.15 * SMA(volume,20)_5m",
      "1m does not print a new 10-minute low during the final confirmation candle"
    ],
    "long_entry": {
      "type": "MARKET_OR_TIGHT_LIMIT_AFTER_CONFIRMED_5M_CLOSE",
      "max_entry_chase": "0.20 * ATR14_15m",
      "cancel_if_price_moves_without_fill": "0.35 * ATR14_15m"
    },
    "short_regime_filter_all": [
      "close_1h < EMA21_1h",
      "EMA9_15m < EMA21_15m",
      "RSI14_15m < 42",
      "15m close breaks the active 1h support with volume >= 1.25 * SMA(volume,20)_15m",
      "spread_pct <= 0.05"
    ],
    "short_trigger_all": [
      "after the break, a 5m pullback/retest fails below broken support",
      "5m EMA9 remains below EMA21",
      "RSI14_5m fails below 50",
      "5m bearish confirmation candle closes below its midpoint with volume >= SMA(volume,20)_5m"
    ],
    "short_note": "SHORT est contre la tendance 4h/1d tant que EMA9_4h > EMA21_4h; risque reduit tant que ce regime n'est pas lui-meme devenu baissier."
  },
  "risk_management": {
    "risk_score_0_to_10": 6.7,
    "risk_label": "ELEVE_MAIS_CONTROLE",
    "risk_per_trade_pct_equity": {
      "long": 0.75,
      "short_countertrend": 0.5,
