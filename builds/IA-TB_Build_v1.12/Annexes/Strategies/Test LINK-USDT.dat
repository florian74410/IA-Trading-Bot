    "margin_mode_derivatives": "ISOLATED_ONLY",
    "max_open_positions_on_symbol": 1,
    "max_total_link_notional_multiple_of_equity": 1.5,
    "stop_model": {
      "atr_timeframe": "15m",
      "base_stop_distance_atr": 1.4,
      "current_reference_distance": 0.0446,
      "current_reference_distance_pct": 0.4709,
      "rule": "For LONG: stop below recent 5m swing low with at least 1.2*ATR15 protection, target about 1.4*ATR15. Reject trade if required stop > 0.75% of entry. Mirror for SHORT.",
      "never_widen_stop_after_entry": true,
      "never_average_down": true
    },
    "profit_management": {
      "tp1_R": 1.0,
      "tp1_close_pct": 35,
      "after_tp1": "Move stop to break-even plus estimated fees/slippage only if market structure remains valid.",
      "tp2_R": 1.8,
      "tp2_close_pct": 40,
      "tp3_management": "Trail remaining 25% using 0.75*ATR15 or last confirmed 5m swing, whichever is tighter.",
      "minimum_expected_RR_to_enter": 1.7
    },
    "time_stop": {
      "if_no_progress_minutes": 30,
      "required_progress_R": 0.35,
      "absolute_max_hold_minutes": 120,
      "action": "EXIT_OR_REDUCE; this is a rapid strategy, capital must not remain trapped."
    },
    "session_guards": {
      "max_consecutive_losses": 2,
      "cooldown_after_max_losses_minutes": 90,
      "max_daily_loss_pct_equity": 2.25,
      "stop_trading_for_day_if_hit": true,
      "max_slippage_pct": 0.08,
      "max_spread_pct": 0.05
    }
  },
  "dynamic_invalidation": {
    "long_invalidation": [
      "1h close below EMA21_1h AND failed reclaim within next 2 completed 5m candles",
      "15m close below active support with abnormal sell volume",
      "4h momentum reversal with EMA9_4h crossing below EMA21_4h",
      "spread or slippage exceeds allowed threshold"
    ],
    "short_invalidation": [
      "1h closes back above EMA21_1h after breakdown",
      "5m retest reclaims broken support with rising buy volume",
      "4h trend remains strongly bullish and short has not moved +0.35R within 30 minutes"
    ]
  },
