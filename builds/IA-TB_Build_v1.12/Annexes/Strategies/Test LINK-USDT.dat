  "chart_structure": {
    "1d": {
      "pattern": "Bullish impulse / breakout from a multi-day base",
      "interpretation": "Hausse forte et volume eleve; tendance de fond positive mais RSI journalier etire, donc ne pas poursuivre le prix sans pullback."
    },
    "4h": {
      "pattern": "High-base / bull-flag-like consolidation after impulsive breakout",
      "interpretation": "Structure encore haussiere au-dessus des moyennes, mais zone 9.60-9.75 agit comme resistance importante."
    },
    "1h": {
      "pattern": "Corrective descending pullback toward EMA21",
      "interpretation": "Le prix corrige sous EMA9 mais reste au-dessus d'EMA21; regime haussier conserve tant que la zone 9.42-9.44 tient."
    },
    "15m": {
      "pattern": "Short-term lower-high/lower-low correction",
      "interpretation": "Momentum vendeur court terme, prix proche de la bande de Bollinger basse; chercher une reprise confirmee, pas un achat aveugle."
    },
    "5m": {
      "pattern": "Oversold corrective leg",
      "interpretation": "RSI proche de 30 et EMA9 sous EMA21; aucune entree LONG avant retournement du momentum."
    },
    "1m": {
      "pattern": "Microstructure de vente en ralentissement pres de 9.46-9.47",
      "interpretation": "Utiliser uniquement pour optimiser le timing; ne jamais prendre une position sur le 1m seul."
