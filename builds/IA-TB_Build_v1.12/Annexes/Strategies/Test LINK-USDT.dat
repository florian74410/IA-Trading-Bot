  "position_sizing": {
    "formula": "risk_amount_quote = equity_quote * risk_pct / 100; stop_distance_quote_per_LINK = abs(entry - stop); quantity_LINK = risk_amount_quote / stop_distance_quote_per_LINK",
    "caps": [
      "Respect max_notional_multiple_of_equity",
      "Respect venue minimum quantity/notional",
      "Round quantity to venue step size",
      "Recalculate after fees and estimated slippage"
    ]
  },
  "ai_execution_protocol": {
    "before_trade": [
      "Refresh all required timeframes and order book.",
      "Recalculate EMA9, EMA21, EMA50 where required, RSI14 Wilder, ATR14, Bollinger20/2 and volume SMA20.",
      "Reject stale data older than 120 seconds.",
      "Classify regime: BULLISH, NEUTRAL or BEARISH.",
      "Evaluate LONG and SHORT rules exactly; do not infer missing conditions.",
      "If neither side passes all mandatory conditions, output NO_TRADE."
    ],
    "on_signal": [
      "Compute entry, hard stop, TP1, TP2 and trailing plan before sending an order.",
      "Compute position size from equity risk, never from desired leverage.",
      "Log the exact indicator values and rules that passed.",
      "Never remove or widen a hard stop.",
      "Never add to a losing position."
    ],
    "after_entry": [
      "Monitor every completed 1m candle for emergency conditions.",
      "Re-evaluate official strategy conditions on each completed 5m candle.",
      "Apply time stop and session loss guards.",
      "Log exit reason: STOP, TP1, TP2, TRAIL, TIME_STOP, INVALIDATION, MANUAL."
    ],
    "output_contract": {
      "required_fields": [
        "decision",
        "side",
        "entry",
        "stop",
        "tp1",
        "tp2",
        "risk_pct_equity",
        "quantity",
        "expected_RR",
        "regime",
        "conditions_passed",
        "conditions_failed",
        "data_timestamp"
      ],
      "allowed_decisions": [
        "NO_TRADE",
        "PREPARE_LONG",
        "PREPARE_SHORT",
        "EXIT",
        "REDUCE"
      ]
    }
  },
  "validation_requirements": {
    "paper_or_testnet_min_trades": 50,
