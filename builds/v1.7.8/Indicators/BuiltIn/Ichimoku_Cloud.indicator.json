{
  "schema": "iatb.indicator.v1",
  "id": "ichimoku_cloud",
  "name": "Ichimoku Cloud",
  "version": "1.0",
  "category": "trend",
  "inputs": {
    "high": {
      "type": "series",
      "default": "high",
      "allowed": [
        "high"
      ]
    },
    "low": {
      "type": "series",
      "default": "low",
      "allowed": [
        "low"
      ]
    },
    "close": {
      "type": "series",
      "default": "close",
      "allowed": [
        "close"
      ]
    },
    "conversion_period": {
      "type": "integer",
      "default": 9,
      "min": 2,
      "max": 200
    },
    "base_period": {
      "type": "integer",
      "default": 26,
      "min": 2,
      "max": 300
    },
    "span_b_period": {
      "type": "integer",
      "default": 52,
      "min": 2,
      "max": 500
    },
    "displacement": {
      "type": "integer",
      "default": 26,
      "min": 0,
      "max": 200
    }
  },
  "engine": {
    "operation": "ichimoku_cloud"
  },
  "outputs": {
    "conversion": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "base": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "span_a": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "span_b": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "lagging": {
      "type": "number",
      "strategy": true,
      "chart": true
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "price",
    "min": null,
    "max": null
  }
}
