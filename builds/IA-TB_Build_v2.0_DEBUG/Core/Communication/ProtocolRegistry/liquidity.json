            "depth",
            "liquidationWindowMs"
          ],
          "required": [
            "symbol"
          ]
        }
      },
      {
        "name": "liquidity.snapshot",
        "arguments": {
          "allowed": [
            "symbol",
            "source",
            "depth",
            "liquidationWindowMs",
            "timeframe",
            "limit"
          ],
          "required": [
            "symbol"
          ]
        }
      },
      {
        "name": "liquidity.financial",
