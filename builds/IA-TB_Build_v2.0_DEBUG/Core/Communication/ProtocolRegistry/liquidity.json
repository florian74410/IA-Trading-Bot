{
  "id": "liquidity",
  "label": "Liquidity Engine",
  "type": "ENGINE",
  "transport": "CP1",
  "endpoint": {
    "host": "127.0.0.1",
    "port": 8014,
    "cpPath": "/cp/v1",
    "healthPath": "/health"
  },
  "table": {
    "commands": [
      {
        "name": "liquidity.health",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "liquidity.zones",
