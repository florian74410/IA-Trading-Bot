{
  "id": "supervisor",
  "label": "IA Supervisor",
  "type": "IA",
  "status": "ACTIVE",
  "transport": "CP1",
  "endpoint": {
    "host": "127.0.0.1",
    "port": 3000,
    "cpPath": "/cp/v1",
    "healthPath": "/health"
  },
  "registration": {
    "dynamic": true
  },
  "policy": {
    "marketData": "READ_ONLY",
    "liquidity": "READ_ONLY"
  },
  "table": {
    "commands": [
      {
        "name": "supervisor.health",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "supervisor.capabilities",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "supervisor.status",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "supervisor.reload",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "supervisor.extensions",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "supervisor.llm.health",
        "arguments": {
          "allowed": [
            "provider"
          ]
        }
      },
      {
        "name": "supervisor.context",
        "arguments": {
          "allowed": [
            "symbol",
            "timeframe",
            "source",
            "limit",
            "fundamentalLimit",
            "correlationId",
            "portfolioTradeLimit",
            "indicatorRequests",
            "indicatorCandles",
            "indicatorSource",
            "indicatorForce",
            "liquiditySource",
            "liquidityDepth",
            "liquidityWindowMs"
          ],
          "required": [
            "symbol"
          ]
        }
      },
      {
        "name": "supervisor.analyze",
        "arguments": {
          "allowed": [
            "symbol",
            "timeframe",
            "source",
            "limit",
            "fundamentalLimit",
            "correlationId",
            "prompt",
            "system",
            "model",
            "temperature",
            "maxTokens",
            "portfolioTradeLimit",
            "indicatorRequests",
            "indicatorCandles",
            "indicatorSource",
            "indicatorForce",
            "liquiditySource",
            "liquidityDepth",
            "liquidityWindowMs"
          ],
          "required": [
            "symbol"
          ]
        }
      },
      {
        "name": "supervisor.indicators",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "supervisor.indicator.language",
        "arguments": {
          "allowed": []
        }
      },
      {
        "name": "supervisor.indicator.validate",
        "arguments": {
          "allowed": [
            "source"
          ],
          "required": [
            "source"
          ]
        }
      },
      {
        "name": "supervisor.indicator.create",
        "arguments": {
          "allowed": [
            "source",
