    "dataTypes": [
      {
        "name": "market.candles",
        "direction": "CONSUME"
      },
      {
        "name": "market.registry",
        "direction": "CONSUME"
      },
      {
        "name": "defi.position",
        "direction": "CONSUME"
      },
      {
