          ],
          "required": [
            "source"
          ]
        }
      },
      {
        "name": "supervisor.indicator.definition",
        "arguments": {
          "allowed": [
            "id"
          ],
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "supervisor.indicators.compute",
        "arguments": {
          "allowed": [
            "id",
            "params",
            "requests",
            "symbol",
            "timeframe",
            "force",
            "candles",
            "source"
          ],
          "required": []
        }
      },
      {
        "name": "supervisor.risk.evaluate",
        "arguments": {
          "allowed": [
            "intent"
          ],
          "required": [
            "intent"
          ]
        }
      },
      {
        "name": "supervisor.reason",
        "arguments": {
          "allowed": [
            "system",
            "prompt",
            "model",
            "temperature",
            "maxTokens",
            "metadata"
          ],
          "required": [
            "prompt"
          ]
        }
      }
