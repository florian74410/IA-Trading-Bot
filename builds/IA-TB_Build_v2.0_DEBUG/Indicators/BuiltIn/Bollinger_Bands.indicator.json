{
  "schema": "iatb.indicator.v1",
  "id": "bollinger_bands",
  "name": "Bollinger Bands",
  "version": "1.0",
  "category": "volatility",
  "inputs": {
    "source": {
      "type": "series",
      "default": "close",
      "allowed": [
        "open",
        "high",
        "low",
        "close"
      ]
    },
    "period": {
      "type": "integer",
      "default": 20,
      "min": 2,
      "max": 500
    },
    "stddev": {
      "type": "number",
      "default": 2.0,
      "min": 0.1,
      "max": 10
    }
  },
  "engine": {
    "operation": "bollinger_bands"
  },
  "outputs": {
    "upper": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "middle": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "lower": {
      "type": "number",
      "strategy": true,
      "chart": true
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "price",
    "min": null,
    "max": null
  }
}
