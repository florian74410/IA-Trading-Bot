{
  "schema": "iatb.indicator.v1",
  "id": "rsi",
  "name": "Relative Strength Index",
  "version": "1.0",
  "category": "momentum",
  "inputs": {
    "source": {
      "type": "series",
      "default": "close",
      "allowed": [
        "open",
        "high",
        "low",
        "close"
      ]
    },
    "period": {
      "type": "integer",
      "default": 14,
      "min": 2,
      "max": 200
    }
  },
  "engine": {
    "operation": "rsi"
  },
  "outputs": {
    "value": {
      "type": "number",
      "strategy": true,
      "chart": true
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "separate",
    "min": 0,
    "max": 100
  }
}
