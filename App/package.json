{
  "name": "ia-tb-runtime",
  "private": true,
  "version": "2.6.0-dev.7",
  "description": "IA-TB unified Node.js runtime",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "ethers": "5.7.2",
    "argon2": "0.45.1"
  },
  "scripts": {
    "test:risk": "node --test --test-concurrency=1 Risk/Tests/snapshots.test.js Risk/Tests/snapshots.integration.test.js Risk/Tests/risk_engine.test.js Risk/Tests/test_risk_gate.js Risk/Tests/test_risk_r1_r2_v25.js Risk/Tests/test_risk_settings_v25.js",
    "bench:risk": "node Risk/Tests/benchmark_snapshots.js",
    "build:risk": "python3 ../Tools/Build/build_risk_snapshot.py",
    "test:okx": "node --test --test-concurrency=1 Portfolio/Tests/okx_account.test.js Portfolio/Tests/okx_pipeline.integration.test.js services/trading-engine/tests/test_account_routing_v253.js Tools/Tests/user_management_trading_vault.test.js",
    "test:cp1": "node --test --test-concurrency=1 Core/FunctionRegistry/Tests/*.test.js",
    "qualify:cp1": "node Tools/qualify_cp1_control.js",
    "test:integration": "node Tools/Tests/SupervisorSimulator/run_validation.js",
    "simulator": "node Tools/Tests/SupervisorSimulator/cli.js",
    "test:chatbot": "node --test --test-concurrency=1 Supervisor/ChatBot/Tests/*.test.js tests/companion-frontend-v1.2.test.js"
  }
}
