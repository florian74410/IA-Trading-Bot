# Host artifacts, mutable state and credentials never belong in the image.
node_modules
**/node_modules
.runtime
**/.runtime
artifacts
**/artifacts
__pycache__
**/__pycache__
.node
**/.node
.git
**/.git
*.backup
*.bak
.env
.env.*
**/.env
**/.env.*
*.sqlite
*.sqlite-*
*.db
*.db-shm
*.db-wal
*.key
*.pem
*.log
# Legacy credentials and private mutable stores
secrets_v2.dat
user.dat
ai_settings_v2.dat
config_v1.0.dat
logs.dat
**/secrets_v2.dat
**/user.dat
**/ai_settings_v2.dat
**/client_master.key
**/wallet_master.key
**/Data/*.db
**/Data/*.sqlite

# This tracked PEM is a public CA trust bundle, not a private key.
!Core/Certificates/cacert.pem

# GEN-1 validation image: unit suites stay versioned in Git, outside the image.
# Unit/integration suites are source-only. Compose smoke/preflight helpers
# remain available in the DEBUG validation image; none starts implicitly.
**/Tests/
**/tests/
**/*.test.js
**/test_*.js
**/self-test.js
# Debug-only isolated launchers and archived report artifacts
**/Reports/
