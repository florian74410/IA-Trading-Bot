{
  "schema": "iatb.indicator.v1",
  "id": "stochastic_rsi",
  "name": "Stochastic RSI",
  "version": "2.1",
  "category": "momentum",
  "inputs": {
    "source": {
      "type": "series",
      "default": "close",
      "allowed": [
        "open",
        "high",
        "low",
        "close"
      ]
    },
    "rsi_period": {
      "type": "integer",
      "default": 14,
      "min": 2,
      "max": 200
    },
    "stoch_period": {
      "type": "integer",
      "default": 14,
      "min": 2,
      "max": 200
    },
    "k_smoothing": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 50
    },
    "d_period": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 50
    }
  },
  "engine": {
    "operation": "stochastic_rsi"
  },
  "outputs": {
    "k": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#4db7ef",
        "width": 2
      }
    },
    "d": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#fcaf57",
        "width": 2
      }
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "separate",
    "min": 0,
    "max": 100,
    "visual": {
      "layers": [],
      "levels": [
        {
          "value": 20,
          "color": "#b38cff"
        },
        {
          "value": 80,
          "color": "#b38cff"
        }
      ],
      "zones": [
        {
          "min": 0,
          "max": 20,
          "color": "#a36dff",
          "opacity": 0.11
        },
        {
          "min": 80,
          "max": 100,
          "color": "#a36dff",
          "opacity": 0.11
        }
      ]
    }
  }
}
