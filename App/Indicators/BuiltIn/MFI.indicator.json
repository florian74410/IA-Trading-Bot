{
  "schema": "iatb.indicator.v1",
  "id": "mfi",
  "name": "Money Flow Index",
  "version": "2.1",
  "category": "volume",
  "inputs": {
    "high": {
      "type": "series",
      "default": "high",
      "allowed": [
        "high"
      ]
    },
    "low": {
      "type": "series",
      "default": "low",
      "allowed": [
        "low"
      ]
    },
    "close": {
      "type": "series",
      "default": "close",
      "allowed": [
        "close"
      ]
    },
    "volume": {
      "type": "series",
      "default": "volume",
      "allowed": [
        "volume"
      ]
    },
    "period": {
      "type": "integer",
      "default": 14,
      "min": 2,
      "max": 200
    }
  },
  "engine": {
    "operation": "mfi"
  },
  "outputs": {
    "value": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#4db7ef",
        "width": 2
      }
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "separate",
    "min": 0,
    "max": 100,
    "visual": {
      "layers": [],
      "levels": [
        {
          "value": 20,
          "color": "#b38cff"
        },
        {
          "value": 80,
          "color": "#b38cff"
        }
      ]
    }
  }
}
