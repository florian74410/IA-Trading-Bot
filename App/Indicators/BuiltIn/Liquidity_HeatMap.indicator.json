{
  "schema": "iatb.indicator.v1",
  "id": "liquidity_heatmap",
  "name": "Liquidity HeatMap",
  "version": "1.0",
  "category": "liquidity",
  "inputs": {
    "strength": {
      "type": "number",
      "default": 0.2,
      "min": 0.05,
      "max": 0.9
    },
    "max_zones": {
      "type": "integer",
      "default": 10,
      "min": 2,
      "max": 12
    }
  },
  "engine": {
    "operation": "liquidity_heatmap",
    "external_service": "LIQUIDITY"
  },
  "outputs": {
    "strength": {
      "type": "number",
      "strategy": true,
      "chart": false
    }
  },
  "strategy": {
    "operators": [
      ">",
      ">=",
      "<",
      "<="
    ]
  },
  "display": {
    "pane": "price",
    "render": "zones",
    "mode": "ESTIMATED"
  }
}
