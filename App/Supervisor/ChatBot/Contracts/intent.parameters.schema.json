{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intent.parameters/1.0",
  "type": "object",
  "properties": {
    "exchange": {
      "enum": [
        "OKX"
      ]
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "environment": {
      "enum": [
        "DEMO",
        "LIVE"
      ]
    },
    "market": {
      "enum": [
        "SPOT",
        "MARGIN",
        "FUTURES",
        "SWAP",
        "OPTION"
      ]
    },
    "asset": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,20}$"
    },
    "quote": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,20}$"
    },
    "instrument_candidate": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{3,64}$"
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "amount_unit": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,20}$"
    },
    "order_type": {
      "enum": [
        "MARKET",
        "LIMIT"
      ]
    },
    "limit_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "trigger_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stop_loss": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "take_profit": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "position_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "position_side": {
      "enum": [
        "LONG",
        "SHORT"
      ]
    },
    "close_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "leverage": {
      "type": "number",
      "minimum": 1,
      "maximum": 125
    },
    "timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ]
    }
  },
  "additionalProperties": false
}
