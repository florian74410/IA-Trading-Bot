{
  "schema": "iatb.indicator.v1",
  "id": "supertrend",
  "name": "Supertrend",
  "version": "1.0",
  "category": "trend",
  "inputs": {
    "high": {
      "type": "series",
      "default": "high",
      "allowed": [
        "high"
      ]
    },
    "low": {
      "type": "series",
      "default": "low",
      "allowed": [
        "low"
      ]
    },
    "close": {
      "type": "series",
      "default": "close",
      "allowed": [
        "close"
      ]
    },
    "atr_period": {
      "type": "integer",
      "default": 10,
      "min": 2,
      "max": 200
    },
    "multiplier": {
      "type": "number",
      "default": 3.0,
      "min": 0.1,
      "max": 20
    }
  },
  "engine": {
    "operation": "supertrend"
  },
  "outputs": {
    "value": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "direction": {
      "type": "number",
      "strategy": true,
      "chart": false
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "price",
    "min": null,
    "max": null
  }
}
