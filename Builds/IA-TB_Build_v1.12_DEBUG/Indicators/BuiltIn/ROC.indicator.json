{
  "schema": "iatb.indicator.v1",
  "id": "roc",
  "name": "Rate of Change",
  "version": "1.0",
  "category": "momentum",
  "inputs": {
    "source": {
      "type": "series",
      "default": "close",
      "allowed": [
        "open",
        "high",
        "low",
        "close"
      ]
    },
    "period": {
      "type": "integer",
      "default": 12,
      "min": 1,
      "max": 500
    }
  },
  "engine": {
    "operation": "roc"
  },
  "outputs": {
    "value": {
      "type": "number",
      "strategy": true,
      "chart": true
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "separate",
    "min": null,
    "max": null
  }
}
