{
  "schema": "iatb.indicator.v1",
  "id": "stochastic",
  "name": "Stochastic Oscillator",
  "version": "1.0",
  "category": "momentum",
  "inputs": {
    "high": {
      "type": "series",
      "default": "high",
      "allowed": [
        "high"
      ]
    },
    "low": {
      "type": "series",
      "default": "low",
      "allowed": [
        "low"
      ]
    },
    "close": {
      "type": "series",
      "default": "close",
      "allowed": [
        "close"
      ]
    },
    "k_period": {
      "type": "integer",
      "default": 14,
      "min": 2,
      "max": 200
    },
    "k_smoothing": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 50
    },
    "d_period": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 50
    }
  },
  "engine": {
    "operation": "stochastic"
  },
  "outputs": {
    "k": {
      "type": "number",
      "strategy": true,
      "chart": true
    },
    "d": {
      "type": "number",
      "strategy": true,
      "chart": true
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "separate",
    "min": 0,
    "max": 100
  }
}
