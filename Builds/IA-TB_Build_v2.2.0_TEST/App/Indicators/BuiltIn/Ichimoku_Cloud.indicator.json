{
  "schema": "iatb.indicator.v1",
  "id": "ichimoku_cloud",
  "name": "Ichimoku Cloud",
  "version": "2.1",
  "category": "trend",
  "inputs": {
    "high": {
      "type": "series",
      "default": "high",
      "allowed": [
        "high"
      ]
    },
    "low": {
      "type": "series",
      "default": "low",
      "allowed": [
        "low"
      ]
    },
    "close": {
      "type": "series",
      "default": "close",
      "allowed": [
        "close"
      ]
    },
    "conversion_period": {
      "type": "integer",
      "default": 9,
      "min": 2,
      "max": 200
    },
    "base_period": {
      "type": "integer",
      "default": 26,
      "min": 2,
      "max": 300
    },
    "span_b_period": {
      "type": "integer",
      "default": 52,
      "min": 2,
      "max": 500
    },
    "displacement": {
      "type": "integer",
      "default": 26,
      "min": 0,
      "max": 200
    }
  },
  "engine": {
    "operation": "ichimoku_cloud"
  },
  "outputs": {
    "conversion": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#23b9fa",
        "width": 2
      }
    },
    "base": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#f79543",
        "width": 2
      }
    },
    "span_a": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#16c784",
        "width": 2
      }
    },
    "span_b": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#ea3943",
        "width": 2
      }
    },
    "lagging": {
      "type": "number",
      "strategy": true,
      "chart": true,
      "visual": {
        "color": "#ad8afb",
        "width": 2
      }
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "price",
    "min": null,
    "max": null,
    "visual": {
      "layers": [
        {
          "type": "cloud",
          "upper": "span_a",
          "lower": "span_b",
          "bullColor": "#16c784",
          "bearColor": "#ea3943",
          "opacity": 0.2
        }
      ]
    }
  }
}
