{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"IA-TB strategy.signal/2.0",
  "type":"object",
  "required":["schema","signal_id","created_at","expires_at","strategy_id","symbol","timeframe","side","action","confidence","execution"],
  "properties":{
    "schema":{"const":"strategy.signal/2.0"},
    "signal_id":{"type":"string"},
    "correlation_id":{"type":"string"},
    "created_at":{"type":"integer"},
    "expires_at":{"type":"integer"},
    "valid_for_sec":{"type":"integer","minimum":1},
    "strategy_id":{"type":"string"},
    "strategy_version":{"type":"string"},
    "symbol":{"type":"string"},
    "timeframe":{"type":"string"},
    "side":{"enum":["BUY","SELL"]},
    "action":{"enum":["BUY","SELL","HOLD"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "score":{"type":"number","minimum":0,"maximum":100},
    "entry":{"type":"object"},
    "risk_hint":{"type":"object"},
    "reasons":{"type":"array"},
    "execution":{"type":"object"}
  }
}
