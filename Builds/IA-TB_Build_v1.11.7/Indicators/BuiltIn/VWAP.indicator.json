{
  "schema": "iatb.indicator.v1",
  "id": "vwap",
  "name": "Volume Weighted Average Price",
  "version": "1.0",
  "category": "volume",
  "inputs": {
    "high": {
      "type": "series",
      "default": "high",
      "allowed": [
        "high"
      ]
    },
    "low": {
      "type": "series",
      "default": "low",
      "allowed": [
        "low"
      ]
    },
    "close": {
      "type": "series",
      "default": "close",
      "allowed": [
        "close"
      ]
    },
    "volume": {
      "type": "series",
      "default": "volume",
      "allowed": [
        "volume"
      ]
    },
    "anchor": {
      "type": "enum",
      "default": "session",
      "allowed": [
        "session",
        "day",
        "week",
        "month"
      ]
    }
  },
  "engine": {
    "operation": "vwap"
  },
  "outputs": {
    "value": {
      "type": "number",
      "strategy": true,
      "chart": true
    }
  },
  "strategy": {
    "operators": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "crosses_above",
      "crosses_below"
    ]
  },
  "display": {
    "pane": "price",
    "min": null,
    "max": null
  },
  "notes": {
    "anchorSemantics": "session/day = UTC day; week = UTC Monday week; month = UTC calendar month"
  }
}
